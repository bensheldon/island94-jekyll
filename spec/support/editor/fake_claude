#!/usr/bin/env ruby
# frozen_string_literal: true

# A stand-in for the `claude` CLI used in tests. Reads the prompt from stdin and
# returns a canned review in the same JSON envelope the real CLI emits, so we
# can exercise the editor deterministically and for free.
require "json"

$stdin.read
checks = JSON.parse(ARGV[ARGV.index("--agents") + 1]).keys

findings =
  if checks == ["grammar"]
    [{ quote: "good", comment: "A grammar finding.", severity: "low", checks: ["grammar"] }]
  else
    # Flag a phrase we know the test fixtures contain.
    [{ quote: "very really actually", comment: "Three empty intensifiers stacked together.", suggestion: "very", severity: "high", checks: [checks.first] }]
  end

puts({ type: "result", subtype: "success", is_error: false, result: "", total_cost_usd: 0.12, structured_output: { findings: findings } }.to_json) # rubocop:disable RSpec/Output
