<%
  if @page == 1
    provide :whole_title, "Island94.org : A lost and found"
  else
    provide :title, "Island94.org : A lost and found"
  end
%>

<% if @page > 1 %>
  <% content_for :head do %>
    <meta name="robots" content="noindex, follow">
  <% end %>
<% end %>

<%= render partial: "post", collection: @posts, as: :post %>

<hr>

<div class="d-flex justify-content-between mb-5">
  <% if @page > 1 %>
    <a href="<%= posts_path(page: @page - 1) %>" class="btn btn-outline-primary">Newer posts</a>
  <% end %>
  <% if @page < (Post.published.size.to_f / @limit).ceil %>
    <a href="<%= posts_path(page: @page + 1) %>" class="btn btn-outline-primary">Older posts</a>
  <% end %>
</div>
