<%= form_with model: pass, scope: :pass, url: pass.persisted? ? pass_path(pass) : passes_path do |form| %>
  <% if pass.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% pass.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-control" %>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= form.label :slug, class: "form-label" %>
      <%= form.text_field :slug, class: "form-control" %>
      <div class="form-text">Unique identifier, e.g. <code>passive-voice</code>.</div>
    </div>
    <div class="col-md-3 mb-3">
      <%= form.label :color, class: "form-label" %>
      <%= form.select :color, Editor::Highlight::COLORS, {}, class: "form-select" %>
    </div>
    <div class="col-md-3 mb-3">
      <%= form.label :position, class: "form-label" %>
      <%= form.number_field :position, class: "form-control" %>
    </div>
  </div>

  <div class="mb-3">
    <%= form.label :prompt, "Prompt", class: "form-label" %>
    <%= form.text_area :prompt, rows: 8, class: "form-control font-monospace", style: "font-size: 0.9rem;" %>
  </div>

  <div class="form-check mb-3">
    <%= form.check_box :active, class: "form-check-input" %>
    <%= form.label :active, "Active", class: "form-check-label" %>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit "Save pass", class: "btn btn-dark" %>
    <%= link_to "Cancel", passes_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
