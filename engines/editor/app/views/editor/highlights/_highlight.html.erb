<div class="commentary-card mb-3 is-<%= highlight.status %> <%= "is-new" if local_assigns[:arriving] %>"
     id="<%= dom_id(highlight) %>"
     data-suggestions-target="card"
     data-anchor-id="<%= highlight.anchor_id %>"
     data-highlight-id="<%= highlight.id %>"
     data-quote="<%= highlight.quote %>"
     data-original-quote="<%= highlight.original_quote || highlight.quote %>"
     data-suggestion="<%= highlight.suggestion %>"
     data-color="<%= highlight.color %>"
     data-status="<%= highlight.status %>"
     data-update-url="<%= document_highlight_path(highlight.document_id, highlight) %>"
     data-action="click->suggestions#focusCard">
  <div class="d-flex align-items-center gap-2">
    <%= color_swatch highlight.color, class: "flex-shrink-0" %>
    <span class="small fw-semibold text-truncate"><%= highlight.pass_name || highlight.category.to_s.humanize %></span>
    <% if highlight.severity.present? && highlight.open? %>
      <span class="badge <%= severity_badge_class(highlight.severity) %>"><%= highlight.severity %></span>
    <% end %>
    <% unless highlight.open? %>
      <span class="ms-auto small text-muted"><%= highlight.status.capitalize %></span>
    <% end %>
  </div>

  <div class="commentary-body">
    <blockquote class="commentary-quote small my-2"><%= highlight.quote %></blockquote>
    <div class="stale-note small text-muted fst-italic mb-2">⚠ The flagged text has been removed.</div>
    <% if highlight.suggestion.present? %>
      <div class="commentary-suggestion small mb-1">
        <span class="text-muted">Suggestion:</span> <%= suggestion_diff(highlight.quote, highlight.suggestion) %>
      </div>
    <% end %>
    <p class="small text-muted mb-2"><%= highlight.comment %></p>
  </div>

  <div class="d-flex gap-3">
    <% if highlight.open? %>
      <% if highlight.suggestion.present? %>
        <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none fw-semibold text-success"
                data-action="annotations#accept:stop">Accept</button>
      <% end %>
      <%= button_to "Resolve", document_highlight_path(highlight.document_id, highlight), method: :patch,
            params: { highlight: { status: "resolved" } }, class: "btn btn-sm btn-link p-0 text-decoration-none" %>
      <%= button_to "Ignore", document_highlight_path(highlight.document_id, highlight), method: :patch,
            params: { highlight: { status: "ignored" } }, class: "btn btn-sm btn-link p-0 text-decoration-none text-muted" %>
    <% else %>
      <%= button_to "Reopen", document_highlight_path(highlight.document_id, highlight), method: :patch,
            params: { highlight: { status: "open" } }, class: "btn btn-sm btn-link p-0 text-decoration-none text-muted" %>
    <% end %>
  </div>
</div>
