<div id="review_panel"
     data-controller="review-poll"
     data-review-poll-url-value="<%= document_reviews_path(document) %>"
     data-review-poll-pending-value="<%= reviews.any?(&:pending?) %>">
  <% if reviews.any? %>
    <ul class="list-unstyled small mb-0 review-list">
      <% reviews.reverse_each do |review| %>
        <li class="d-flex align-items-center gap-2 py-1 review-<%= review.interrupted? ? "interrupted" : review.status %>">
          <%= color_swatch review.color, class: "flex-shrink-0 color-swatch-sm" %>
          <span class="text-truncate"><%= review.pass_name %></span>
          <span class="ms-auto text-nowrap text-muted">
            <% if review.interrupted? %>
              Interrupted
            <% elsif review.status == "queued" %>
              Queued
            <% elsif review.status == "running" %>
              <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
              Reviewing… <%= review.duration.to_i %>s
            <% elsif review.status == "succeeded" %>
              <%= pluralize(review.created_count, "finding") %> · <%= review.duration.to_i %>s<% if review.cost_usd %>
                · <span title="What this review would have cost at API prices. Reviews use your Claude subscription.">~<%= number_to_currency(review.cost_usd) %> API-equivalent</span>
              <% end %>
            <% else %>
              <span class="text-danger" title="<%= review.error %>">Failed</span>
            <% end %>
          </span>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
