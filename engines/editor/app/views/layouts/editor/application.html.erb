<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= [content_for(:title), "Editor"].compact.join(" · ") %></title>
  <%= csrf_meta_tags %>
  <%= vite_client_tag %>
  <%= vite_javascript_tag "/engines/editor/app/javascript/editor.js" %>
</head>
<body class="editor">
  <nav class="navbar border-bottom bg-body">
    <div class="container-fluid">
      <%= link_to "✎ Editor", root_path, class: "navbar-brand fw-semibold" %>
      <div class="d-flex gap-2">
        <%= link_to "Editing passes", passes_path, class: "btn btn-sm btn-outline-secondary" %>
        <%= link_to "View blog", main_app.root_path, class: "btn btn-sm btn-outline-secondary" %>
      </div>
    </div>
  </nav>

  <% if notice %>
    <div class="container-fluid mt-3"><div class="alert alert-success py-2 mb-0"><%= notice %></div></div>
  <% end %>
  <% if alert %>
    <div class="container-fluid mt-3"><div class="alert alert-warning py-2 mb-0"><%= alert %></div></div>
  <% end %>

  <main class="container-fluid py-4">
    <%= yield %>
  </main>
</body>
</html>
